<% layout("/layouts/boilerplate") %>

<div class="row">
    <div class="col-8 offset-3">
        <h3>Listings Details</h3>
    </div>

    <div class="card col-6 offset-3">
        <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="listing_image">

        <div class="card-body">
            <p class="card-text fs-5">
                <b><%= listing.title %></b><br>
                <%= listing.description %><br>
                &#x20B9; <%= listing.price != null ? listing.price.toLocaleString('en-IN') : 'Price not available' %><br>
                <%= listing.location %><br>
                <%= listing.country %>
            </p>
        </div>
    </div>

    <!-- Edit and Delete buttons below the card -->
    <div class="col-6 offset-3 mt-3 mb-4">
        <a href="/listings/<%= listing._id %>/edit" class="btn add-btn">Edit</a>

        <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline">
            <button class="btn btn-dark">Delete</button>
        </form>
    </div>
</div>

    </div>

